{
  "name": "my-website",
  "version": "1.0.0",
  "description": "个人网站项目 - 包含前端和后端",
  "keywords": [
    "blog",
    "express",
    "gallery",
    "mongodb",
    "personal-website",
    "vue3"
  ],
  "license": "MIT",
  "author": "Vorest",
  "scripts": {
    "dev": "concurrently \"vp run backend:dev\" \"vp run frontend:dev\"",
    "backend:dev": "vp -C backend run dev",
    "frontend:dev": "vp -C frontend dev",
    "backend:start": "vp -C backend run start",
    "frontend:build": "vp -C frontend build",
    "install:all": "vp install && vp -C backend install && vp -C frontend install",
    "test:api": "node test-login-api.js",
    "prepare": "vp config",
    "frontend:preview": "vp -C frontend preview",
    "test": "vp test --run"
  },
  "dependencies": {
    "axios": "^1.9.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dompurify": "^3.2.6",
    "dotenv": "^16.5.0",
    "echarts": "^5.6.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "marked": "^15.0.12",
    "morgan": "^1.10.0",
    "multer": "^2.0.0",
    "mysql2": "^3.14.1",
    "nodemailer": "^7.0.3",
    "openai": "^6.9.1",
    "sequelize": "^6.37.7"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.10",
    "vite-plus": "1.0.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.19.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  }
}
